{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.ai-log/**)",
      "Read(./.kilo/**)",
      "Read(./pipelines/workspaces/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/.next/**)",
      "Read(./presentation/**)",
      "Read(./**/*.duckdb)",
      "Read(./**/*.sqlite)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/_pyrun.sh scripts/log_hook.py --tool=claude",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
