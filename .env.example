# ============================================
# P-113 — Biến môi trường
# ============================================
# Chép file này thành .env rồi sửa. KHÔNG BAO GIỜ commit .env.
# Chỉ với các giá trị mặc định dưới đây, hệ thống chạy được hoàn toàn (giai đoạn A, không cần khóa).

# ---- LLM ----
# mock = câu trả lời cố định (mô phỏng, không cần khóa)
# openai = mô hình thật theo config/models.yaml | google = Gemini cho mọi bước (cần GOOGLE_API_KEY)
LLM_PROVIDER=mock
# Tên model theo từng bước KHÔNG đặt ở đây: sửa config/models.yaml.
# Hiện tại: Planner/Codegen/Testgen = OpenAI (cần OPENAI_API_KEY), Optimizer = Claude Opus 5.5 (cần ANTHROPIC_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Dự phòng: model chính gọi thất bại (mạng, hạn mức) thì chuyển sang Gemini (model ở mục fallback). none = tắt.
LLM_FALLBACK=google
# Circuit breaker cho mỗi cặp nhà cung cấp × model: ngắt mạch khi lỗi liên tiếp, gọi dự phòng ngay thay vì chờ timeout.
# BREAKER_MIN_CALLS=4       # số lượt tối thiểu trong cửa sổ 10 lượt gần nhất trước khi xét tỉ lệ lỗi
# BREAKER_FAILURE_RATE=0.5  # tỉ lệ lỗi tối thiểu để ngắt (0–1)
# BREAKER_RESET_SEC=60      # ngắt bao lâu rồi mới thử lại
# BREAKER_PROBES=1          # số lượt thăm dò thành công để đóng lại (1–3)
# Chỉ Codegen dùng (tối đa 0.2); Planner/Testgen = 0; Opus 5.5 (Optimizer) không nhận temperature
LLM_TEMPERATURE=0
# Trần chung; mỗi bước có trần riêng nhỏ hơn (src/config.py TASK_MAX_TOKENS)
LLM_MAX_TOKENS=16000
# Gửi JSON Schema đầu ra (structured output); false = quay về chế độ json_object cũ
LLM_STRUCTURED_OUTPUT=true

# ---- Đăng nhập + cơ sở dữ liệu ứng dụng (PostgreSQL) ----
# Chỉ điền TÊN biến ở file này; giá trị thật đặt trong .env (không commit). Khi lên cloud: dịch vụ quản lý bí mật.
# Vai trò: engineer (tạo yêu cầu), reviewer (duyệt/từ chối), admin (quản lý tài khoản). Không có đăng ký tự do.
# Tài khoản ỨNG DỤNG (không phải superuser). Cục bộ (docker compose, cổng 5433; dùng 127.0.0.1, "localhost" trên Windows thử IPv6 trước và bị treo):
#   postgresql+psycopg://p113_app:<mật khẩu>@127.0.0.1:5433/p113_dev
# Triển khai thật: bắt buộc thêm ?sslmode=verify-full
DATABASE_URL=
# Tài khoản MIGRATION (đổi cấu trúc bảng), chỉ dùng khi chạy `alembic upgrade head`
#   postgresql+psycopg://p113_migrator:<mật khẩu>@127.0.0.1:5433/p113_dev
MIGRATION_DATABASE_URL=
# Test: CSDL riêng p113_test (tài khoản migration, tên phải chứa "test"). Trống thì test dùng SQLite tạm.
#   postgresql+psycopg://p113_migrator:<mật khẩu>@127.0.0.1:5433/p113_test
TEST_DATABASE_URL=
# ---- Neon (dev/test/demo, chỉ tài khoản thử) — hướng dẫn: docs/NEON.md mục 3 ----
# Dán chuỗi từ Neon Console → Connect (branch dev), đổi đầu thành postgresql+psycopg://, rồi bỏ dấu # và
# thay 3 dòng DATABASE_URL / MIGRATION_DATABASE_URL / TEST_DATABASE_URL đang trỏ Docker ở trên:
# DATABASE_URL=postgresql+psycopg://p113_app:<mật khẩu>@<ep-...-pooler>.ap-southeast-1.aws.neon.tech/p113?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# MIGRATION_DATABASE_URL=postgresql+psycopg://p113_migrator:<mật khẩu>@<ep-...>.ap-southeast-1.aws.neon.tech/p113?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# TEST_DATABASE_URL=postgresql+psycopg://p113_migrator:<mật khẩu>@<ep-...>.ap-southeast-1.aws.neon.tech/p113_test?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# Mật khẩu cho docker compose (dịch vụ db) tạo 2 tài khoản trên
POSTGRES_PASSWORD=
# Cổng PostgreSQL của docker compose trên máy (mặc định 5433)
P113_DB_PORT=5433
P113_MIGRATOR_PASSWORD=
P113_APP_PASSWORD=
# Khóa ký phiên: ≥ 32 ký tự ngẫu nhiên, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi khóa (xoay vòng) = mọi phiên đang mở mất hiệu lực, người dùng đăng nhập lại.
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Cookie chỉ gửi qua HTTPS (localhost vẫn chạy được). Thử qua IP mạng nội bộ bằng http thì tạm đặt false.
SESSION_COOKIE_SECURE=true
# lax khi web và API cùng tên miền gốc; khác tên miền (Vercel + Render) cần none (kèm Secure) hoặc proxy chung miền
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# true khi triển khai: chuyển hướng HTTP sang HTTPS
FORCE_HTTPS=false
# (uvicorn) Khi chạy sau proxy và FORCE_HTTPS=true: đặt * để tin X-Forwarded-Proto (Render/Cloud Run)
# FORWARDED_ALLOW_IPS=*

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Lưu trữ (SQLite + DuckDB, mặc định trong ./data và ./pipelines/workspaces) ----
# STORE_PATH=./data/app.db
# CHECKPOINT_PATH=./data/checkpoints.db
# Nơi lưu lần chạy, sổ lỗi, bộ nhớ agent và checkpoint: sqlite (mặc định, file trong data/) hoặc postgres (Neon, dùng DATABASE_URL).
# STATE_BACKEND=sqlite
# Số lần chạy cùng lúc (1–4). Chỉ có tác dụng khi STATE_BACKEND=postgres; SQLite luôn chạy 1 luồng.
# RUN_WORKERS=2
# SOURCES_DIR=./data/sources
# WORKSPACES_DIR=./pipelines/workspaces

# ---- Sandbox & giới hạn vòng lặp ----
SANDBOX_TIMEOUT_SEC=300
SANDBOX_MEMORY_LIMIT=1GB
# Số luồng DuckDB trong sandbox
SANDBOX_THREADS=2
MAX_FIX_ATTEMPTS=3
# Giới hạn theo người (người tạo yêu cầu): số lần chạy đang chờ/đang chạy cùng lúc; trần chi phí LLM mỗi ngày
# theo giờ VN (USD, 0 = không chặn; LLM_PROVIDER=mock không tính)
MAX_ACTIVE_RUNS_PER_USER=2
LLM_DAILY_BUDGET_USD=1
# Sổ chi phí (ADR 0014): mỗi lượt gọi LLM thật được giữ trước khoản dự toán xấu nhất trên mọi hạn mức; không đủ thì không gọi.
# LLM_DAILY_BUDGET_USD tính theo ngày gọi (gồm khoản đang giữ và lượt chưa rõ chi phí). Hai trần dưới mặc định 0 = tắt;
# chọn mức rồi mới bật. Trần mỗi lần chạy cộng dồn mọi lượt chạy tiếp; trần toàn hệ thống tính cả lượt gọi không gắn người (eval).
RUN_COST_BUDGET_USD=0
LLM_GLOBAL_DAILY_BUDGET_USD=0

# ---- Cửa kiểm tra đầu vào + trần chi phí toàn hệ thống (luật mẫu tấn công/động từ/đồng nghĩa: config/input_gate.yaml) ----
# Yêu cầu ngắn hơn / dài hơn bị chặn trước khi tốn token (0 token ở tầng 0–1). Đặt 0 ở các trần = không chặn.
INPUT_MIN_CHARS=10
INPUT_MAX_CHARS=2000
# Số kết quả kiểm tra nhớ lại cho câu giống hệt (chuẩn hóa rồi băm); 0 = tắt bộ nhớ đệm
INPUT_GATE_CACHE_SIZE=512
# Tối đa số vòng hỏi làm rõ mỗi lần chạy; quá số vòng thì dừng và chuyển cho kỹ sư dữ liệu
MAX_CLARIFY_ROUNDS=2
# Trần token (vào + ra) mỗi lần chạy; vượt thì dừng và báo rõ. 0 = không chặn
RUN_TOKEN_BUDGET=200000
# Số lần chạy tối đa mỗi người mỗi ngày (giờ VN); lần bị chặn ở cửa kiểm tra đầu vào không tính. 0 = không chặn
USER_DAILY_RUN_LIMIT=30

# ---- Sổ nguồn dữ liệu, mức truy cập của LLM, bí mật nguồn (giai đoạn 3; xem docs/adr/0006-0008) ----
# Mức dữ liệu AI được xem, mặc định cho nguồn ĐĂNG KÝ MỚI: schema_only (chỉ cấu trúc) < profile (thống kê + dạng giá trị, không dòng
# thật) < masked_sample (vài dòng đã che, chỉ nguồn độ nhạy cảm thấp). Đây là điều chỉnh so với quyết định ban đầu "chỉ cho xem
# schema"; đặt schema_only để quay về như cũ. Nguồn high luôn bị ép về schema_only, medium tối đa profile.
LLM_ACCESS_DEFAULT=profile
# Trần số dòng đã che ở mức masked_sample
LLM_SAMPLE_MAX_ROWS=5
# true: người tạo yêu cầu không tự duyệt được (đặt false khi chạy demo cá nhân bằng một tài khoản)
REQUIRE_SEPARATE_REVIEWER=true
# Bí mật của nguồn: sổ nguồn chỉ lưu TÊN tham chiếu (vd conn_orders_db); giá trị thật đặt ở máy chủ bằng biến môi trường
# P113_SECRET_<TÊN IN HOA> (vd P113_SECRET_CONN_ORDERS_DB) hoặc file <SECRETS_DIR>/<tên>. Không bao giờ commit giá trị.
# SECRETS_DIR=/run/secrets
# Bộ nạp nguồn: thời hạn kết nối/truy vấn (giây), số dòng tối đa mỗi bảng nạp vào sandbox (bảng lớn hơn chỉ nạp một tập con có
# hạt giống cố định), băm cột nhạy cảm khi nạp sandbox: auto (chỉ nguồn độ nhạy cảm high) | always | never, muối băm (bí mật)
CONNECTOR_TIMEOUT_SEC=15
SANDBOX_LOAD_MAX_ROWS=100000
SANDBOX_HASH_SENSITIVE=auto
# SANDBOX_HASH_SALT=
# Nguồn PostgreSQL thử (docker compose --profile dev-sources): mật khẩu quản trị và cổng
# P113_SOURCES_ADMIN_PASSWORD=
# P113_SOURCES_PORT=5434

# ---- Optimizer ----
OPT_MIN_GAIN_PCT=15
OPT_RUNS_PER_MONTH=30
OPT_MAX_ATTEMPTS=3
# Báo cáo điểm nghẽn (0 token): số model chậm nhất được EXPLAIN ANALYZE, giới hạn thời gian phân tích (giây)
PERF_TOP_N=3
PERF_ANALYZE_SEC=10
MOCK_LARGE_ROWS=300000

# ---- Từ điển nghiệp vụ (giai đoạn 6) ----
# Số thuật ngữ tối đa đưa vào prompt Planner (chọn bằng khớp từ khóa với yêu cầu). 0 = tắt, Planner không nhận thuật ngữ nào.
GLOSSARY_MAX_TERMS=3

# ---- Giám sát thay đổi cấu trúc nguồn (giai đoạn 5) ----
# Khóa nội bộ cho POST /api/v1/sources/check-drift (lịch GitHub Actions). KHÔNG đặt trong repo; trống = endpoint tắt.
DRIFT_CHECK_TOKEN=
# Cảnh báo thống kê (chỉ cảnh báo, không chặn): % rỗng tăng hơn N điểm; số dòng lệch hơn N lần so với bản cơ sở
DRIFT_NULL_PCT_DELTA=20
DRIFT_ROWCOUNT_RATIO=3
# Pipeline sinh ra: test fail khi hơn tỷ lệ này (0.01 = 1%) dòng không ép được kiểu
CAST_FAIL_THRESHOLD=0.01
# Cửa G1 (kiểm cấu trúc trước mỗi run). Chỉ tắt khi test/demo cá nhân.
DRIFT_GATE_ENABLED=true

# ---- LangSmith (tùy chọn — tắt mặc định) ----
# Guide dùng tên LANGSMITH_*, LangChain dùng LANGCHAIN_*; hệ thống chấp nhận cả hai.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p113-pipeline-agent
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=p113-pipeline-agent

# ---- AI Hook Logging (do BTC cấp, mỗi thành viên một khóa riêng) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (giai đoạn B) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Địa chỉ backend cho proxy `rewrites` khi web và API khác miền (xem .env.production.example)
# BACKEND_URL=
# NEXT_PUBLIC_ADMIN_CONTACT=admin@congty.vn   # CÔNG KHAI (tùy chọn): email quản trị viên hiện ở nút "Liên hệ quản trị viên" trang đăng nhập.
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true   # CÔNG KHAI: hiện tài khoản demo ở trang đăng nhập. Chỉ bật khi chạy demo cục bộ, không bật trên production.
