# ============================================
# P-113 — Biến môi trường
# ============================================
# Chép file này thành .env rồi sửa. KHÔNG BAO GIỜ commit .env.
# Chỉ với các giá trị mặc định dưới đây, hệ thống chạy được hoàn toàn (giai đoạn A, không cần khóa).

# ---- LLM ----
# mock = câu trả lời cố định (mô phỏng, không cần khóa)
# openai = mô hình thật theo config/models.yaml | google = Gemini cho mọi bước (cần GOOGLE_API_KEY)
LLM_PROVIDER=mock
# Tên model theo từng bước KHÔNG đặt ở đây: sửa config/models.yaml.
# Hiện tại: Planner/Codegen/Testgen = OpenAI (cần OPENAI_API_KEY), Optimizer = Claude Opus 5.5 (cần ANTHROPIC_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Dự phòng: model chính gọi thất bại (mạng, hạn mức) thì chuyển sang Gemini (model ở mục fallback). none = tắt.
LLM_FALLBACK=google
# Chỉ Codegen dùng (tối đa 0.2); Planner/Testgen = 0; Opus 5.5 (Optimizer) không nhận temperature
LLM_TEMPERATURE=0
# Trần chung; mỗi bước có trần riêng nhỏ hơn (src/config.py TASK_MAX_TOKENS)
LLM_MAX_TOKENS=16000
# Gửi JSON Schema đầu ra (structured output); false = quay về chế độ json_object cũ
LLM_STRUCTURED_OUTPUT=true

# ---- Đăng nhập + cơ sở dữ liệu ứng dụng (PostgreSQL) ----
# Chỉ điền TÊN biến ở file này; giá trị thật đặt trong .env (không commit). Khi lên cloud: dịch vụ quản lý bí mật.
# Vai trò: engineer (tạo yêu cầu), reviewer (duyệt/từ chối), admin (quản lý tài khoản). Không có đăng ký tự do.
# Tài khoản ỨNG DỤNG (không phải superuser). Cục bộ (docker compose, cổng 5433; dùng 127.0.0.1, "localhost" trên Windows thử IPv6 trước và bị treo):
#   postgresql+psycopg://p113_app:<mật khẩu>@127.0.0.1:5433/p113_dev
# Triển khai thật: bắt buộc thêm ?sslmode=verify-full
DATABASE_URL=
# Tài khoản MIGRATION (đổi cấu trúc bảng), chỉ dùng khi chạy `alembic upgrade head`
#   postgresql+psycopg://p113_migrator:<mật khẩu>@127.0.0.1:5433/p113_dev
MIGRATION_DATABASE_URL=
# Test: CSDL riêng p113_test (tài khoản migration, tên phải chứa "test"). Trống thì test dùng SQLite tạm.
#   postgresql+psycopg://p113_migrator:<mật khẩu>@127.0.0.1:5433/p113_test
TEST_DATABASE_URL=
# ---- Neon (dev/test/demo, chỉ tài khoản thử) — hướng dẫn: docs/NEON.md mục 3 ----
# Dán chuỗi từ Neon Console → Connect (branch dev), đổi đầu thành postgresql+psycopg://, rồi bỏ dấu # và
# thay 3 dòng DATABASE_URL / MIGRATION_DATABASE_URL / TEST_DATABASE_URL đang trỏ Docker ở trên:
# DATABASE_URL=postgresql+psycopg://p113_app:<mật khẩu>@<ep-...-pooler>.ap-southeast-1.aws.neon.tech/p113?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# MIGRATION_DATABASE_URL=postgresql+psycopg://p113_migrator:<mật khẩu>@<ep-...>.ap-southeast-1.aws.neon.tech/p113?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# TEST_DATABASE_URL=postgresql+psycopg://p113_migrator:<mật khẩu>@<ep-...>.ap-southeast-1.aws.neon.tech/p113_test?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# Mật khẩu cho docker compose (dịch vụ db) tạo 2 tài khoản trên
POSTGRES_PASSWORD=
# Cổng PostgreSQL của docker compose trên máy (mặc định 5433)
P113_DB_PORT=5433
P113_MIGRATOR_PASSWORD=
P113_APP_PASSWORD=
# Khóa ký phiên: ≥ 32 ký tự ngẫu nhiên, tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi khóa (xoay vòng) = mọi phiên đang mở mất hiệu lực, người dùng đăng nhập lại.
SESSION_SECRET=
SESSION_TTL_MINUTES=480
# Cookie chỉ gửi qua HTTPS (localhost vẫn chạy được). Thử qua IP mạng nội bộ bằng http thì tạm đặt false.
SESSION_COOKIE_SECURE=true
# lax khi web và API cùng tên miền gốc; khác tên miền (Vercel + Render) cần none (kèm Secure) hoặc proxy chung miền
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# true khi triển khai: chuyển hướng HTTP sang HTTPS
FORCE_HTTPS=false
# (uvicorn) Khi chạy sau proxy và FORCE_HTTPS=true: đặt * để tin X-Forwarded-Proto (Render/Cloud Run)
# FORWARDED_ALLOW_IPS=*

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Lưu trữ (SQLite + DuckDB, mặc định trong ./data và ./pipelines/workspaces) ----
# STORE_PATH=./data/app.db
# CHECKPOINT_PATH=./data/checkpoints.db
# Nơi lưu lần chạy, sổ lỗi, bộ nhớ agent và checkpoint: sqlite (mặc định, file trong data/) hoặc postgres (Neon, dùng DATABASE_URL).
# STATE_BACKEND=sqlite
# Số lần chạy cùng lúc (1–4). Chỉ có tác dụng khi STATE_BACKEND=postgres; SQLite luôn chạy 1 luồng.
# RUN_WORKERS=2
# SOURCES_DIR=./data/sources
# WORKSPACES_DIR=./pipelines/workspaces

# ---- Sandbox & giới hạn vòng lặp ----
SANDBOX_TIMEOUT_SEC=300
SANDBOX_MEMORY_LIMIT=1GB
# Số luồng DuckDB trong sandbox
SANDBOX_THREADS=2
MAX_FIX_ATTEMPTS=3
# Giới hạn theo người (người tạo yêu cầu): số lần chạy đang chờ/đang chạy cùng lúc; trần chi phí LLM mỗi ngày
# theo giờ VN (USD, 0 = không chặn; LLM_PROVIDER=mock không tính)
MAX_ACTIVE_RUNS_PER_USER=2
LLM_DAILY_BUDGET_USD=1

# ---- Optimizer ----
OPT_MIN_GAIN_PCT=15
OPT_RUNS_PER_MONTH=30
OPT_MAX_ATTEMPTS=3
MOCK_LARGE_ROWS=300000

# ---- LangSmith (tùy chọn — tắt mặc định) ----
# Guide dùng tên LANGSMITH_*, LangChain dùng LANGCHAIN_*; hệ thống chấp nhận cả hai.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p113-pipeline-agent
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=p113-pipeline-agent

# ---- AI Hook Logging (do BTC cấp, mỗi thành viên một khóa riêng) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (giai đoạn B) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Địa chỉ backend cho proxy `rewrites` khi web và API khác miền (xem .env.production.example)
# BACKEND_URL=
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true   # CÔNG KHAI: hiện tài khoản demo ở trang đăng nhập. Chỉ bật khi chạy demo cục bộ, không bật trên production.
