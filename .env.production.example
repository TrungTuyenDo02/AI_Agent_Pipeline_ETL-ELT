# ============================================
# P-113 — Biến môi trường khi TRIỂN KHAI (Render backend + Vercel frontend + Neon)
# ============================================
# File mẫu: KHÔNG điền giá trị thật ở đây, KHÔNG commit giá trị thật.
# Giá trị bí mật (đánh dấu [BÍ MẬT]) chỉ nhập ở trang Environment của Render. Hướng dẫn: docs/DEPLOY_VERCEL.md.
# Bản demo (quyết định 2026-10-13): gói Render miễn phí, KHÔNG gắn ổ đĩa → SQLite trong data/ (lịch sử lần chạy,
# checkpoint, sổ lỗi) và DuckDB sandbox mất mỗi lần khởi động lại; server tự nạp lại dữ liệu mẫu khi bật.
# Dữ liệu cần giữ lâu dài (tài khoản, nhật ký kiểm toán, ảnh chụp cấu trúc) nằm ở Neon.

# ===== A. RENDER (backend Docker) =====

# ---- App ----
APP_ENV=production
LOG_LEVEL=INFO
# Render tự cấp cổng qua biến PORT; Dockerfile đã chạy `--port ${PORT:-8000}`, không cần đặt APP_PORT.
# Chuyển hướng HTTP → HTTPS; FORWARDED_ALLOW_IPS=* để uvicorn tin tiêu đề X-Forwarded-Proto của proxy Render
# (thiếu thì chuyển hướng lặp vô tận).
FORCE_HTTPS=true
FORWARDED_ALLOW_IPS=*
# Chỉ địa chỉ Vercel của dự án, KHÔNG dùng *. (Dùng proxy `rewrites` cùng miền thì CORS gần như không cần.)
CORS_ORIGINS=https://<ten-du-an>.vercel.app

# ---- Đăng nhập + cơ sở dữ liệu (Neon, branch production) ----
# Role p113_app, database p113, host -pooler, đầu chuỗi postgresql+psycopg://, đuôi
#   ?sslmode=verify-full&sslrootcert=system&connect_timeout=15
# [BÍ MẬT]
DATABASE_URL=
# Chỉ cần khi chạy `alembic upgrade head` (thường chạy từ máy). Role p113_migrator, KHÔNG pooling.
# [BÍ MẬT]
MIGRATION_DATABASE_URL=
# Chuỗi MỚI hoàn toàn, ≥ 32 ký tự: python -c "import secrets; print(secrets.token_urlsafe(48))"
# [BÍ MẬT]
SESSION_SECRET=
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=true
# lax khi dùng proxy `rewrites` (khuyến nghị); none nếu web và API gọi khác miền trực tiếp
SESSION_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- LLM ----
# mock = demo không tốn tiền; openai = model thật theo config/models.yaml
LLM_PROVIDER=mock
# [BÍ MẬT] chỉ khi LLM_PROVIDER=openai
OPENAI_API_KEY=
# [BÍ MẬT] Optimizer (Claude) khi LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
# [BÍ MẬT] dự phòng Gemini; không có khóa thì đặt LLM_FALLBACK=none
GOOGLE_API_KEY=
LLM_FALLBACK=google
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16000
LLM_STRUCTURED_OUTPUT=true

# ---- Sandbox & giới hạn (gói miễn phí ít RAM: giữ thấp, chỉnh lại sau khi chạy thử) ----
SANDBOX_TIMEOUT_SEC=180
SANDBOX_MEMORY_LIMIT=256MB
SANDBOX_THREADS=1
MAX_FIX_ATTEMPTS=3
# Giới hạn theo người (người tạo yêu cầu): số lần chạy đang chờ/đang chạy cùng lúc; trần chi phí LLM mỗi ngày
# theo giờ VN (USD, 0 = không chặn; LLM_PROVIDER=mock không tính)
MAX_ACTIVE_RUNS_PER_USER=2
LLM_DAILY_BUDGET_USD=1
# Bộ dữ liệu `large` cho optimizer: nhỏ hơn bản máy (300000) để vừa RAM; quá nhỏ thì optimizer đo không ra khác biệt
MOCK_LARGE_ROWS=30000
OPT_MIN_GAIN_PCT=15
OPT_RUNS_PER_MONTH=30
OPT_MAX_ATTEMPTS=3

# ---- LangSmith: tắt (chỉ bật khi có khóa thật) ----
LANGCHAIN_TRACING_V2=false
# [BÍ MẬT] để trống khi tắt
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p113-pipeline-agent

# KHÔNG đặt trên Render: AI_LOG_* (ghi log AI chỉ dùng khi phát triển ở máy), POSTGRES_PASSWORD, P113_*_PASSWORD,
# TEST_DATABASE_URL (chỉ cho pytest), AWS_* (không dùng Storage của Neon).

# ===== B. VERCEL (frontend Next.js) — đặt TRƯỚC KHI build =====
# NEXT_PUBLIC_* là CÔNG KHAI (nhúng vào bản build): không bao giờ đặt bí mật ở đây.
# NEXT_PUBLIC_API_URL=/
# Địa chỉ backend Render cho proxy `rewrites` (frontend/next.config.ts); không phải bí mật
# BACKEND_URL=https://<ten-dich-vu>.onrender.com
