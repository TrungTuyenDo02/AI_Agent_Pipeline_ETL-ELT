# ============================================
# P-113 — Biến môi trường
# ============================================
# Chép file này thành .env rồi sửa. KHÔNG BAO GIỜ commit .env.
# Chỉ với các giá trị mặc định dưới đây, hệ thống chạy được hoàn toàn (giai đoạn A, không cần khóa).

# ---- LLM ----
# mock = câu trả lời cố định (mô phỏng, không cần khóa)
# openai = mô hình thật (cần OPENAI_API_KEY) | google = Gemini cho mọi bước (cần GOOGLE_API_KEY)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Model theo từng bước (OpenAI). Để trống MODEL_PLANNER/CODEGEN/TESTGEN thì dùng MODEL_NAME.
MODEL_NAME=gpt-5.6-luna
MODEL_PLANNER=
MODEL_CODEGEN=
MODEL_TESTGEN=
MODEL_OPTIMIZER=gpt-5.6-terra
# Dự phòng: OpenAI gọi thất bại (mạng, hạn mức) thì chuyển sang Gemini. none = tắt dự phòng.
LLM_FALLBACK=google
GOOGLE_MODEL_NAME=gemini-3.1-flash-lite
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16000

# ---- Duyệt (J2) ----
# false = một vai trò DE, tự duyệt được | true = bắt buộc Reviewer khác người tạo yêu cầu
REQUIRE_SEPARATE_REVIEWER=false

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- Lưu trữ (SQLite + DuckDB, mặc định trong ./data và ./pipelines/workspaces) ----
# STORE_PATH=./data/app.db
# CHECKPOINT_PATH=./data/checkpoints.db
# SOURCES_DIR=./data/sources
# WORKSPACES_DIR=./pipelines/workspaces

# ---- Sandbox & giới hạn vòng lặp ----
SANDBOX_TIMEOUT_SEC=300
SANDBOX_MEMORY_LIMIT=1GB
MAX_FIX_ATTEMPTS=3

# ---- Optimizer ----
OPT_MIN_GAIN_PCT=15
OPT_RUNS_PER_MONTH=30
OPT_MAX_ATTEMPTS=3
MOCK_LARGE_ROWS=300000

# ---- LangSmith (tùy chọn — tắt mặc định) ----
# Guide dùng tên LANGSMITH_*, LangChain dùng LANGCHAIN_*; hệ thống chấp nhận cả hai.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=p113-pipeline-agent
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=p113-pipeline-agent

# ---- AI Hook Logging (do BTC cấp, mỗi thành viên một khóa riêng) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (giai đoạn B) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
